---
/**
 * Newsletter signup via Buttondown's embed-subscribe endpoint.
 * Deliberately a plain HTML POST (no fetch): Buttondown's docs say not to call
 * this endpoint from JavaScript; the visitor lands on Buttondown's confirmation page.
 * The input must be named "email" or Buttondown silently ignores the submission.
 */
const user = import.meta.env.PUBLIC_BUTTONDOWN_USER ?? '';
if (!user) {
  console.warn('[NewsletterForm] PUBLIC_BUTTONDOWN_USER is not set; the newsletter form will render but submissions will fail. See docs/forms.md.');
}
const action = `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(user)}`;
---
<form class="form" name="newsletter" method="POST" action={action} style="max-width:420px">
  <input type="hidden" name="embed" value="1">
  <div class="field">
    <label for="nl">Tu correo</label>
    <input id="nl" name="email" type="email" placeholder="nombre@correo.com" required>
  </div>
  <div><button class="btn" type="submit">Suscribirme</button></div>
</form>
