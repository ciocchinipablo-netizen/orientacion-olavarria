---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description, ogType = 'website', image, imageAlt, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image || '/og.png', Astro.site).href;
// Width/height are only known for the default share image (1200×630).
const isDefaultImage = imageUrl === new URL('/og.png', Astro.site).href;
const ogImageAlt =
  imageAlt ||
  (isDefaultImage
    ? 'Orientación Olavarría · Espacio de orientación vocacional y ocupacional · Pablo Ciocchini, psicólogo'
    : undefined);
const path = Astro.url.pathname;

const links = [
  { href: '/', label: 'Inicio' },
  { href: '/proceso/', label: 'El proceso' },
  { href: '/sobre-mi/', label: 'Sobre mí' },
  { href: '/blog/', label: 'Artículos' },
  { href: '/contacto/', label: 'Contacto' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="utf-8">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="viewport" content="width=device-width, initial-scale=1">
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:locale" content="es_AR">
<meta property="og:site_name" content="Orientación Olavarría">
<meta property="og:image" content={imageUrl}>
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt}>}
{isDefaultImage && <meta property="og:image:width" content="1200">}
{isDefaultImage && <meta property="og:image:height" content="630">}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={imageUrl}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<Font cssVariable="--font-playfair" preload={[{ weight: 400, style: 'normal' }]} />
<slot name="head" />
</head>
<body>

<nav class="sitenav">
  <a class="brand" href="/">
    <b>Orientación Olavarría</b>
    <span>Vocacional · Ocupacional</span>
  </a>
  <div class="tabs">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
    ))}
  </div>
</nav>

<slot />

<footer class="foot">
  <span>Orientación Olavarría · Espacio de orientación vocacional y ocupacional<br>Pablo Ciocchini · Lic. en Psicología · M.P. 40361 · Olavarría, Buenos Aires</span>
  <span><a href="https://instagram.com/orientacionolav" target="_blank" rel="noopener">Instagram</a> · <a href="https://wa.me/5492284332382" target="_blank" rel="noopener">WhatsApp</a></span>
</footer>

</body>
</html>
