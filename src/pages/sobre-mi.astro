---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import pablo from '../assets/pablo.jpg';
import { siteGraph } from '../lib/schema';
---
<BaseLayout title="Pablo Ciocchini, psicólogo (M.P. 40361) · Orientación Olavarría" description="Pablo Ciocchini, Lic. en Psicología (UNLP, M.P. 40361), formado en orientación vocacional y ocupacional. Atiende en Olavarría y online.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(siteGraph)} />

<section class="band hero">
  <div class="bio">
    <div class="photo"><Picture src={pablo} alt="Pablo Ciocchini" formats={['avif', 'webp']} widths={[280, 560]} sizes="(max-width: 700px) 280px, 250px" loading="eager" /></div>
    <div class="stack">
      <p class="eyebrow">Sobre mí</p>
      <h1>Pablo Ciocchini</h1>
      <p class="lead">Soy psicólogo y trabajo la orientación vocacional y ocupacional en Olavarría, presencial y online.</p>
      {/* Bio pendiente — dos párrafos en primera persona. Guía:
         1) Párrafo pendiente, en primera persona: la orientación vocacional como una rama de la psicología que siempre te interesó, y que hoy es especialmente relevante — la caída de las grandes instituciones modernas le dio al sujeto más libertad, pero también la responsabilidad de sostener solo un montón de decisiones que antes venían más encuadradas. A eso se le suma la incertidumbre que mete la irrupción de la IA en el mundo laboral. Ese cruce genera mucha ansiedad, y es ahí donde trabajás.
         2) Segundo párrafo pendiente: tu enfoque de trabajo — no la elección como un evento único y definitivo, sino algo que se repite a lo largo de la vida. Qué te distingue en cómo acompañás ese proceso. */}
      <dl class="facts">
        <div class="fact"><dt>Matrícula</dt><dd>M.P. 40361</dd></div>
        <div class="fact"><dt>Formación</dt><dd>Lic. en Psicología — UNLP, 2017</dd></div>
        <div class="fact"><dt>Posgrado</dt><dd>Introducción a la Orientación Vocacional Ocupacional (Centro de Salud Mental N.º 3) · en curso: Orientación Vocacional, Teoría y Práctica, con Sergio Rascovan</dd></div>
        <div class="fact"><dt>Atiende en</dt><dd>Olavarría y online</dd></div>
      </dl>
    </div>
  </div>
</section>

</BaseLayout>
