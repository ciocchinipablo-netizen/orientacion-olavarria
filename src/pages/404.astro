---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada — Orientación Olavarría" description="La página que buscás no existe o se movió." noindex>

<section class="band hero">
  <div class="stack wide">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no existe.</h1>
    <p class="lead">Puede que el enlace esté roto o que la página se haya movido.</p>
    <div class="btnrow">
      <a class="btn" href="/">Volver al inicio</a>
      <a class="btn ghost" href="/blog/">Ver los artículos</a>
    </div>
  </div>
</section>

</BaseLayout>
