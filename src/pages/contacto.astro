---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<BaseLayout title="Contacto — Orientación Olavarría" description="Escribime para coordinar una primera entrevista de orientación vocacional en Olavarría, presencial u online.">

<section class="band hero">
  <div class="stack wide">
    <p class="eyebrow">Contacto</p>
    <h1>Escribime.</h1>
    <p class="lead">Contame brevemente en qué andás. Respondo dentro de las 48 horas hábiles.</p>
  </div>
</section>

<section class="band tint">
  <ContactForm />
</section>

</BaseLayout>
